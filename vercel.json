{
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "fuzedflow.com"
        }
      ],
      "destination": "https://www.fuzedflow.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "fuzedflow.com"
        }
      ],
      "destination": "https://www.fuzedflow.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/client-portal-icon.js": {
      "maxDuration": 15
    }
  }
}
