{
  "name": "PurchaseOrderItem",
  "type": "object",
  "properties": {
    "purchase_order_id": {
      "type": "string"
    },
    "product_id": {
      "type": "string"
    },
    "product_name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "quantity": {
      "type": "number",
      "default": 1
    },
    "unit_cost": {
      "type": "number",
      "default": 0
    },
    "line_total": {
      "type": "number",
      "default": 0
    },
    "received_quantity": {
      "type": "number",
      "default": 0,
      "description": "Quantity received so far"
    }
  },
  "required": [
    "purchase_order_id",
    "product_name"
  ]
}