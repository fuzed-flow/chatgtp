{
  "name": "InvoicePaymentScheduleItem",
  "type": "object",
  "properties": {
    "invoice_id": {
      "type": "string",
      "description": "Associated invoice ID"
    },
    "payment_name": {
      "type": "string",
      "description": "Name of this payment (e.g., 'Deposit', 'Payment 1', 'Final Payment')"
    },
    "amount": {
      "type": "number",
      "description": "Payment amount"
    },
    "amount_type": {
      "type": "string",
      "enum": [
        "fixed",
        "percentage"
      ],
      "default": "fixed",
      "description": "Whether amount is fixed dollar or percentage"
    },
    "percentage": {
      "type": "number",
      "description": "Percentage of total (if amount_type is percentage)"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "description": "When this payment is due"
    },
    "due_event": {
      "type": "string",
      "description": "When this payment is due (e.g., 'Upon approval', 'Before delivery', 'Upon completion')"
    },
    "status": {
      "type": "string",
      "enum": [
        "Pending",
        "Paid",
        "Overdue"
      ],
      "default": "Pending"
    },
    "amount_paid": {
      "type": "number",
      "default": 0,
      "description": "Amount paid for this specific payment"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Display order"
    }
  },
  "required": [
    "invoice_id",
    "payment_name"
  ]
}