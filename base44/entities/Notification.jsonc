{
  "name": "Notification",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "LeadFollowUp",
        "QuoteExpiring",
        "QuoteOpened",
        "InvoiceOverdue",
        "ProjectUpdate",
        "ApprovalSigned",
        "ChangeOrderApproved",
        "System"
      ]
    },
    "title": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "related_type": {
      "type": "string",
      "enum": [
        "Lead",
        "Quote",
        "Project",
        "Invoice",
        "ChangeOrder",
        "Approval"
      ]
    },
    "related_id": {
      "type": "string"
    },
    "is_read": {
      "type": "boolean",
      "default": false
    },
    "action_url": {
      "type": "string"
    }
  },
  "required": [
    "title"
  ]
}