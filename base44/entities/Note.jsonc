{
  "name": "Note",
  "type": "object",
  "properties": {
    "related_type": {
      "type": "string",
      "enum": [
        "Client",
        "Project",
        "Quote",
        "Lead"
      ],
      "description": "Type of entity this note is related to"
    },
    "related_id": {
      "type": "string",
      "description": "ID of the related entity"
    },
    "content": {
      "type": "string",
      "description": "Note content"
    },
    "category": {
      "type": "string",
      "enum": [
        "General",
        "Meeting",
        "Phone Call",
        "Email",
        "Important",
        "Follow-up",
        "Issue",
        "Decision"
      ],
      "default": "General",
      "description": "Note category for filtering"
    },
    "author_name": {
      "type": "string",
      "description": "Name of the person who created the note"
    }
  },
  "required": [
    "related_type",
    "related_id",
    "content"
  ]
}