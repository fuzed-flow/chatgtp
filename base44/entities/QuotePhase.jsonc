{
  "name": "QuotePhase",
  "type": "object",
  "properties": {
    "quote_id": {
      "type": "string"
    },
    "phase_name": {
      "type": "string"
    },
    "scope_of_work": {
      "type": "string"
    },
    "show_scope_to_client": {
      "type": "boolean",
      "default": true,
      "description": "Whether to show scope of work to the client"
    },
    "internal_notes": {
      "type": "string",
      "description": "Internal notes for this phase (not shown to client)"
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "is_optional": {
      "type": "boolean",
      "default": false,
      "description": "Whether this phase is optional for client to approve"
    },
    "default_selected": {
      "type": "boolean",
      "default": false,
      "description": "Whether this optional phase appears pre-selected to the client"
    }
  },
  "required": [
    "quote_id",
    "phase_name"
  ]
}