{
  "name": "ScopeLibrarySection",
  "type": "object",
  "properties": {
    "category": {
      "type": "string",
      "enum": [
        "Basement",
        "Kitchen",
        "Bathroom",
        "Deck",
        "General",
        "Custom"
      ]
    },
    "section_title": {
      "type": "string"
    },
    "default_text": {
      "type": "string"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "section_title"
  ]
}