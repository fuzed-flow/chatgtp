{
  "name": "PaymentSchedule",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string"
    },
    "quote_id": {
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "schedule_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Draft",
        "Sent",
        "Active",
        "Complete"
      ],
      "default": "Draft"
    },
    "total_contract_value": {
      "type": "number"
    }
  },
  "required": [
    "schedule_name"
  ]
}