{
  "name": "EstimateTemplateItem",
  "type": "object",
  "properties": {
    "template_id": {
      "type": "string"
    },
    "product_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "quantity_formula": {
      "type": "string",
      "description": "Formula like 'area/10' or fixed number"
    },
    "default_quantity": {
      "type": "number",
      "default": 1
    },
    "unit": {
      "type": "string",
      "default": "ea"
    },
    "unit_cost": {
      "type": "number",
      "default": 0
    },
    "unit_price": {
      "type": "number",
      "default": 0
    },
    "taxable": {
      "type": "boolean",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "template_id",
    "name"
  ]
}