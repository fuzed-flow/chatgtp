{
  "name": "QuotePaymentScheduleItem",
  "type": "object",
  "properties": {
    "quote_id": {
      "type": "string",
      "description": "Associated quote ID"
    },
    "payment_name": {
      "type": "string",
      "description": "Name of this payment (e.g., 'Deposit', 'Payment 1', 'Final Payment')"
    },
    "amount": {
      "type": "number",
      "description": "Payment amount"
    },
    "amount_type": {
      "type": "string",
      "enum": [
        "fixed",
        "percentage"
      ],
      "default": "fixed",
      "description": "Whether amount is fixed dollar or percentage"
    },
    "percentage": {
      "type": "number",
      "description": "Percentage of total (if amount_type is percentage)"
    },
    "due_event": {
      "type": "string",
      "description": "When this payment is due (e.g., 'Upon approval', 'Before delivery', 'Upon completion')"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Display order"
    }
  },
  "required": [
    "quote_id",
    "payment_name"
  ]
}