{
  "name": "Client",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "Residential",
        "Commercial"
      ],
      "default": "Residential"
    },
    "name": {
      "type": "string"
    },
    "primary_contact_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "billing_address": {
      "type": "string"
    },
    "site_address": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name"
  ]
}