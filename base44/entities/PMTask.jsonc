{
  "name": "PMTask",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "Reference to Project"
    },
    "phase_id": {
      "type": "string",
      "description": "Reference to PMPhase (optional)"
    },
    "milestone_id": {
      "type": "string",
      "description": "Reference to PMMilestone (optional)"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Backlog",
        "Ready",
        "In Progress",
        "Blocked",
        "Done"
      ],
      "default": "Backlog"
    },
    "priority": {
      "type": "string",
      "enum": [
        "Low",
        "Medium",
        "High",
        "Urgent"
      ],
      "default": "Medium"
    },
    "start_date_target": {
      "type": "string",
      "format": "date"
    },
    "due_date_target": {
      "type": "string",
      "format": "date"
    },
    "due_date_actual": {
      "type": "string",
      "format": "date"
    },
    "assignee_ref": {
      "type": "string",
      "description": "User email"
    },
    "assignee_name": {
      "type": "string"
    },
    "client_visible": {
      "type": "boolean",
      "default": false
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "project_id",
    "title"
  ]
}